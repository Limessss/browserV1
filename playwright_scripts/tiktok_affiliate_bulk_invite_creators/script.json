{
  "id": "tiktok_affiliate_bulk_invite_creators",
  "name": "TikTok 联盟批量邀约达人",
  "description": "打开 TikTok Shop 联盟达人发现页，应用筛选，勾选达人，切换到创建新邀请、选仅佣金、填表（含商品ID、佣金率、联系方式）后发送邀约。",
  "entry": "tiktok_affiliate_bulk_invite_creators.mjs",
  "order": 46,
  "tags": [
    "playwright",
    "tiktok",
    "affiliate",
    "creator",
    "invite"
  ],
  "version": "1.5.0",
  "defaultArgs": [
    "--useLaunchApi",
    "--code",
    "BUPM2Z",
    "--shop_region",
    "PH",
    "--max_creators",
    "50",
    "--useNewFlow",
    "--product_category",
    "\u5973\u88c5\u4e0e\u5973\u58eb\u5185\u8863-\u5973\u58eb\u5185\u8863",
    "--product_ids",
    "1733357293296059415",
    "--creator_search",
    "top",
    "--random_sort",
    "true"
  ],
  "argsHint": "可在启动参数面板图形化配置；亦支持 CLI。多站点时脚本会读取顶栏站点标识，不一致则点头像切换（不依赖 URL）。关键步骤有页面 Toast 与结束汇总 Modal。更多高级筛选见 mcp 文档。",
  "requiresLaunchServer": true,
  "mcpDoc": "mcp_tiktok_affiliate_bulk_invite_creators.md",
  "argForm": [
    {
      "type": "info",
      "text": "本脚本会真实勾选达人并发送联盟邀约。请确认商品 ID、佣金率与邀约人数后再保存默认设置。"
    },
    {
      "id": "use_launch",
      "flag": "--useLaunchApi",
      "type": "boolean",
      "asFlag": true,
      "label": "通过 NexBrowser 自动连接浏览器",
      "description": "推荐开启：使用已登录联盟后台的实例。",
      "default": true
    },
    {
      "id": "code",
      "flag": "--code",
      "type": "text",
      "label": "环境码",
      "description": "NexBrowser 实例 code，例如 BUPM2Z。",
      "placeholder": "例如 BUPM2Z",
      "default": "BUPM2Z",
      "required": true,
      "showWhen": { "use_launch": true }
    },
    {
      "id": "cdp",
      "flag": "--cdp",
      "type": "text",
      "label": "CDP 调试地址",
      "description": "直连已打开浏览器时使用。",
      "placeholder": "http://127.0.0.1:19876",
      "showWhen": { "use_launch": false }
    },
    {
      "id": "shop_region",
      "flag": "--shop_region",
      "type": "multiselect",
      "label": "要执行的站点（按顺序）",
      "description": "目标站点（MY/PH 等）；打开页面后若顶栏站点与所选不一致，会自动点头像切换。多站点按顺序依次执行。",
      "default": ["PH"],
      "options": [
        { "value": "MY", "label": "马来西亚 MY" },
        { "value": "PH", "label": "菲律宾 PH" },
        { "value": "SG", "label": "新加坡 SG" },
        { "value": "TH", "label": "泰国 TH" },
        { "value": "VN", "label": "越南 VN" },
        { "value": "ID", "label": "印尼 ID" }
      ]
    },
    {
      "id": "max_creators",
      "flag": "--max_creators",
      "type": "number",
      "label": "本轮最多邀约达人数",
      "description": "勾选并发送邀约的达人上限，脚本内部最大 50，默认 50。",
      "default": 50,
      "min": 1,
      "max": 50
    },
    {
      "id": "useNewFlow",
      "flag": "--useNewFlow",
      "type": "boolean",
      "asFlag": true,
      "label": "使用「创建新邀约」流程",
      "description": "推荐保持勾选：走创建新邀请 → 仅佣金 → 填表发送。",
      "default": true
    },
    {
      "id": "product_category",
      "flag": "--product_category",
      "type": "text",
      "label": "商品类目筛选",
      "description": "页面筛选下拉中的类目文案；多级用连字符，例如「女装与女士内衣-女士内衣」。",
      "default": "女装与女士内衣-女士内衣",
      "placeholder": "女装与女士内衣-女士内衣"
    },
    {
      "id": "product_ids",
      "flag": "--product_ids",
      "type": "text",
      "label": "商品 ID（必填）",
      "description": "邀约中要添加的商品，多个用英文逗号分隔。",
      "default": "1733357293296059415",
      "placeholder": "1733357293296059415",
      "required": true
    },
    {
      "id": "creator_search",
      "flag": "--creator_search",
      "type": "text",
      "label": "达人搜索关键词",
      "description": "查找达人页顶部搜索框内容，默认 top 表示按默认列表浏览。",
      "default": "top",
      "placeholder": "top 或 bra 等"
    },
    {
      "id": "random_sort",
      "flag": "--random_sort",
      "type": "select",
      "label": "随机排序依据",
      "description": "筛选后是否从 GMV、粉丝数、互动率等中随机选一种排序。",
      "default": "true",
      "options": [
        { "value": "true", "label": "是（随机）" },
        { "value": "false", "label": "否（可指定下方排序）" }
      ]
    },
    {
      "id": "sort_by",
      "flag": "--sort_by",
      "type": "select",
      "label": "指定排序依据",
      "description": "关闭随机排序时使用。",
      "default": "互动率",
      "showWhen": { "random_sort": "false" },
      "options": [
        { "value": "相关性", "label": "相关性" },
        { "value": "GMV", "label": "GMV" },
        { "value": "成交件数", "label": "成交件数" },
        { "value": "粉丝数", "label": "粉丝数" },
        { "value": "平均视频播放量", "label": "平均视频播放量" },
        { "value": "互动率", "label": "互动率" }
      ]
    },
    {
      "id": "standard_commission_rate",
      "flag": "--standard_commission_rate",
      "type": "number",
      "label": "标准佣金率（%）",
      "description": "邀约表单中商品的标准佣金，默认 12。",
      "default": 12,
      "min": 1,
      "max": 80
    },
    {
      "id": "shop_ads_commission_rate",
      "flag": "--shop_ads_commission_rate",
      "type": "number",
      "label": "店铺广告佣金率（%）",
      "description": "开启店铺广告佣金后填写的比率，默认 6。",
      "default": 6,
      "min": 1,
      "max": 80
    },
    {
      "id": "expiration_days",
      "flag": "--expiration_days",
      "type": "number",
      "label": "邀约有效期（天）",
      "description": "从发起到截止的天数，默认 365（约一年）。",
      "default": 365,
      "min": 1,
      "max": 365
    },
    {
      "id": "facebook",
      "flag": "--facebook",
      "type": "text",
      "label": "联系 Facebook 账号",
      "description": "邀约表单中的 Facebook 联系方式，默认 linkeoo。",
      "default": "linkeoo"
    }
  ]
}
