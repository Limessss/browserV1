{
  "name": "nexbrowser-desktop",
  "private": true,
  "version": "0.1.0",
  "author": "NexBrowser",
  "type": "module",
  "description": "NexBrowser — Electron + React + Node（从 Wails/Go 迁移）。目录对齐原 Ant-Browser 仓库结构。",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "smoke:runtime": "node scripts/smoke-runtime-check.mjs",
    "fetch:xray:win": "node scripts/fetch-xray-windows.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && npm run icons && electron-builder",
    "dist:win": "npm run build && npm run icons && npm run fetch:xray:win && electron-builder --win",
    "dist:win:installer": "npm run build && npm run icons && npm run fetch:xray:win && electron-builder --win --x64 -c.win.target=nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "http-proxy": "^1.18.1",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.292.0",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "socks-proxy-agent": "^10.0.0",
    "sql.js": "^1.13.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.3",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "to-ico": "^1.1.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.nexbrowser.desktop",
    "productName": "NexBrowser",
    "icon": "build/icon.png",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterSign": "./scripts/electron-after-sign.mjs",
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "."
      }
    ],
    "extraFiles": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "playwright_scripts",
        "to": "playwright_scripts.bundled",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright",
        "to": "node_modules/playwright",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright-core",
        "to": "node_modules/playwright-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
